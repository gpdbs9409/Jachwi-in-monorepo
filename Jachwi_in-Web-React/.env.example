# Auth Server (로그인/회원가입/토큰)
VITE_AUTH_API_URL=http://localhost:8081

# Main Server (지도/커뮤니티/LLM)
VITE_MAIN_API_URL=http://localhost:8080

# 네이버 지도 JavaScript API 웹용 Client ID
# https://console.ncloud.com 에서 "Maps" > "Web Dynamic Map" 서비스로 별도 발급 필요
# (Flutter 앱에서 쓰던 모바일 SDK용 Client ID "g4v4m4nte0" 와는 다른 값이어야 함)
VITE_NAVER_MAP_CLIENT_ID=
